# Prefer `npm run docker:init`; it generates database and application passwords.
COMPOSE_PROJECT_NAME=survey
LOCAL_PORT=3000
POSTGRES_DB=survey
POSTGRES_USER=survey
POSTGRES_PASSWORD=replace-with-at-least-20-url-safe-random-characters
SIMULATION_TERMINATION_ENABLED=false
# Optional outer shared gate. Application-user sessions remain authoritative.
DEPLOY_AUTH_ENABLED=false
DEPLOY_USERNAME=
DEPLOY_PASSWORD=

# Optional: only used with compose.llm.yaml; default compose remains Mock.
# LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# LLM_MODEL=your-model
# LLM_SOURCE=cloud
# LLM_AUTH_REQUIRED=true
# LLM_API_KEY=server-only-secret
# LLM_TIMEOUT_SECONDS=60
